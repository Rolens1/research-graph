# InsForge Database & Auth Configuration
NEXT_PUBLIC_INSFORGE_URL=https://your-project.insforge.com
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-insforge-anon-key

# Autonomous Agent Web Search Engines (Server Runtime Only)
TAVILY_API_KEY=your-tavily-api-key
EXA_API_KEY=your-exa-api-key

# Autonomous Multi-Agent LLM Providers (Server Runtime Only)
# Priority: Google Gemini -> Groq -> OpenRouter -> SambaNova -> Cerebras -> OpenAI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

SAMBANOVA_API_KEY=your-sambanova-api-key
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
